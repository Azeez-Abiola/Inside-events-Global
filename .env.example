# ── Required for Vercel (build + runtime) ──────────────────────
# Add ALL of these in Vercel → Project → Settings → Environment Variables.
# Scope: Production + Preview. VITE_* must also be present at BUILD time (redeploy after adding).
#
# Minimum for public pages (landing, marketplace) to load:
#   VITE_SUPABASE_URL, VITE_SUPABASE_PUBLISHABLE_KEY
#
# Full app (auth, messaging, admin, emails) also needs at runtime:
#   SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, SUPABASE_SERVICE_ROLE_KEY
#
# Client bundle (VITE_ prefix — baked in at build)
VITE_SITE_URL=https://www.insideglobalevents.com
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Marketplace is public by default. Set to false only to re-gate temporarily.
# VITE_MARKETPLACE_PUBLIC=false

# Server-side SSR + server functions (runtime — no VITE_ prefix)
SITE_URL=https://www.insideglobalevents.com
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Email (Resend) ─────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL="Inside Global Events <noreply@insideglobalevents.com>"
# From Supabase Dashboard → Auth → Hooks → Send Email (generate secret there)
SEND_EMAIL_HOOK_SECRET=v1,whsec_your_hook_secret

# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYSTACK_SECRET_KEY=

# ── AI Brand-Readiness Coach (optional) ────────────────────────
# Without it the coach still scores events and writes checklist cards;
# with it, "Ask the AI coach" writes tailored cards using Claude.
# ANTHROPIC_API_KEY=sk-ant-...

# ── Scheduled jobs (Vercel Cron → /api/cron/daily) ─────────────
# Vercel sends this as a Bearer token on each cron call.
# CRON_SECRET=a-long-random-string
# Optional: home page Instagram strip (long-lived token on IGE's own account)
# INSTAGRAM_ACCESS_TOKEN=

# ── Sign-in protection ──────────────────────────────────────────
# Five failed sign-ins in 15 minutes lock the address briefly; after that a
# Cloudflare Turnstile CAPTCHA is required. Without these keys the lock
# still applies but no CAPTCHA is shown.
# VITE_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Admin two-factor sign-in is on by default. Set both to "false" only as a
# temporary escape hatch (e.g. if TOTP is disabled on the Supabase project).
# VITE_ADMIN_MFA_REQUIRED=false
# ADMIN_MFA_REQUIRED=false
